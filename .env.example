# Copia este archivo a .env para desarrollo local.
# En Hostinger, carga estas variables en hPanel (Web App → Environment variables).
# NUNCA subas el .env real a Git.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# URL pública de la app (se usa en logs y en el README del cron)
PUBLIC_URL=http://localhost:3000

# ---------- Seguridad ----------
# Token para POST /jobs/run (lo usa el cron de hPanel). Genera uno largo y aleatorio.
JOBS_TOKEN=cambia-esto-por-un-token-largo-jobs
# Token para /status y reintentos manuales.
ADMIN_TOKEN=cambia-esto-por-un-token-largo-admin

# ---------- Base de datos (MySQL / MariaDB de hPanel) ----------
DB_HOST=127.0.0.1
# DB_PORT es también el puerto que docker compose publica en el host.
# Si 3306 ya está ocupado por otro MySQL/MariaDB local, usa 3307 (o cualquier otro libre).
DB_PORT=3306
DB_USER=ecolife_sync
DB_PASSWORD=ecolife_sync
DB_NAME=ecolife_sync
# Ejecutar migraciones al arrancar (útil en Hostinger)
RUN_MIGRATIONS_ON_START=true

# ---------- WooCommerce ----------
WOO_URL=https://ecolifescooters.com
WOO_CONSUMER_KEY=ck_xxx
WOO_CONSUMER_SECRET=cs_xxx
# Secreto que pones al crear el webhook en WooCommerce (Ajustes → Avanzado → Webhooks)
WOO_WEBHOOK_SECRET=cambia-esto
# Estados de pedido que se envían al destino (separados por coma)
SYNC_ORDER_STATUSES=processing,completed
# Claves de meta donde se guarda el NIF/CIF (depende del plugin de checkout)
WOO_VAT_META_KEYS=_billing_nif,billing_nif,_billing_vat,billing_vat

# ---------- Destino ----------
# Adaptador de destino activo. Hoy: odoo. Futuro: zoho-books, zoho-crm...
TARGET=odoo

# ---------- Odoo ----------
ODOO_URL=https://tu-empresa.odoo.com
ODOO_DB=tu-empresa
ODOO_LOGIN=integracion@ecolifescooters.com
ODOO_API_KEY=xxx
# json2 = API JSON-2 (Odoo 19+). jsonrpc = API clásica (Odoo 18 o anterior).
ODOO_API=json2
# Confirmar el pedido en Odoo (true) o dejarlo como presupuesto (false)
ODOO_CONFIRM_ORDERS=false
# Referencia interna del producto de servicio "Envío" en Odoo
ODOO_SHIPPING_PRODUCT_SKU=ENVIO
# Referencia interna del producto para cargos extra (fees) de WooCommerce
ODOO_FEE_PRODUCT_SKU=CARGO
# Prefijo de la referencia del pedido en Odoo (client_order_ref)
ODOO_ORDER_REF_PREFIX=WEB-

# ---------- Stock Odoo → WooCommerce ----------
STOCK_SYNC_ENABLED=false
# Ubicación de stock a usar (vacío = todas las internas)
ODOO_STOCK_LOCATION_ID=

# ---------- Procesamiento ----------
# Máximo de jobs por ejecución de /jobs/run
JOBS_BATCH_SIZE=20
# Tiempo máximo (ms) por ejecución de /jobs/run
JOBS_TIME_BUDGET_MS=25000
# Intentos antes de marcar un job como "dead"
JOBS_MAX_ATTEMPTS=5
